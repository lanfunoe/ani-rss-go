# 本地调试用：复制为 .env 后按需取消注释。
# .env 只在进程的工作目录下读取，不覆盖已存在的环境变量；命令行参数优先级最高。

# HTTP 监听端口，默认 7789
# PORT=7790

# 前端静态文件目录，为空时使用内嵌前端
# WEB_DIR=../ani-rss-ui/dist

# 配置目录，默认使用当前目录下的 config
# CONFIG=./config

# 以下变量只在首次生成 config.json 时作为默认值，之后以 config.json 为准
# MIKAN_HOST=https://mikanani.me
# DOWNLOAD_TOOL_TYPE=qBittorrent
# DOWNLOAD_TOOL_HOST=http://127.0.0.1:8080
# DOWNLOAD_TOOL_USERNAME=admin
# DOWNLOAD_TOOL_PASSWORD=
